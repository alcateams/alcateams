// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid(7))
  email         String   @unique
  name          String
  password      String
  rainbowUserId String   @unique
  createdAt     DateTime @default(now())

  communityMembers CommunityMember[]
  eventAttendees   EventAttendee[]
  themeSuggestions ThemeSuggestion[]
  knowledgeItems   KnowledgeItem[]
}

enum GlobalRole {
  ADMIN
  MODERATOR
  MEMBER
}

model Community {
  id          String   @id @default(uuid(7))
  name        String
  description String   @db.Text
  createdAt   DateTime @default(now())

  members          CommunityMember[]
  subgroups        Subgroup[]
  events           Event[]
  themeSuggestions ThemeSuggestion[]
}

model CommunityMember {
  id           String     @id @default(uuid(7))
  userId       String
  communityId  String
  role         GlobalRole @default(MEMBER)
  joinedAt     DateTime   @default(now())
  warningCount Int        @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model Subgroup {
  id              String   @id @default(uuid(7))
  name            String
  theme           String?
  communityId     String
  rainbowBubbleId String   @unique
  createdAt       DateTime @default(now())

  community      Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  knowledgeItems KnowledgeItem[]
}

model KnowledgeItem {
  id               String   @id @default(uuid(7))
  subgroupId       String
  authorId         String?
  rainbowMessageId String   @unique
  content          String   @db.Text
  tags             String[]
  isPinned         Boolean  @default(true)

  lastIndexedAt DateTime? // Null means not indexed by MeiliSearch

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subgroup Subgroup @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Event {
  id             String   @id @default(uuid(7))
  title          String
  communityId    String
  startTime      DateTime
  endTime        DateTime
  conferenceLink String
  createdAt      DateTime @default(now())

  community Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  attendes  EventAttendee[]
}

model EventAttendee {
  id      String @id @default(uuid(7))
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ThemeSuggestion {
  id            String           @id @default(uuid(7))
  suggestedName String
  status        SuggestionStatus @default(PENDING)
  userId        String
  communityId   String
  createdAt     DateTime

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}
