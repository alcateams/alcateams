// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String            @id
  email       String            @unique
  pseudo      String            @unique
  bio         String?
  urls        String[]          @default([])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  communities CommunityMember[]
  messages    Message[]
}

enum CommunityRole {
  MODERATOR
  MEMBER
}

model Community {
  id          String            @id @default(uuid())
  name        String            @unique
  description String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  subGroups   SubGroup[]
  members     CommunityMember[]
}

enum SubGroupKind {
  // The community-wide channel ("Général"), one per community.
  GENERAL
  THEMATIC
}

// A thematic sub-group ("sous-groupe") of a community, backed by one Rainbow bubble
// (the "bulle": a place of exchange around a precise subject).
model SubGroup {
  id              String       @id @default(uuid())
  communityId     String
  name            String
  theme           String
  kind            SubGroupKind @default(THEMATIC)
  rainbowBubbleId String       @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  community       Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([communityId, name])
}

model CommunityMember {
  communityId String
  userId      String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
}

enum RainbowSyncStatus {
  PENDING
  SYNCED
  FAILED
}

// A message posted in a sub-group. Postgres is the source of truth; each message is then
// mirrored to the sub-group's Rainbow bubble, and `rainbowSyncStatus` tracks that mirroring.
model Message {
  id                String            @id @default(uuid())
  subGroupId        String
  authorId          String
  text              String
  rainbowMessageId  String?
  rainbowSyncStatus RainbowSyncStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  subGroup          SubGroup          @relation(fields: [subGroupId], references: [id], onDelete: Cascade)
  author            User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([subGroupId, createdAt])
}
