# Port the Express server listens on (optional, defaults to 3000).
PORT=3000

# PostgreSQL connection string used by Prisma.
# See https://pris.ly/d/connection-strings for all the available options.
DATABASE_URL=""

# Rainbow identity provider configuration.
# Base URL of the Rainbow API (e.g. https://openrainbow.com).
RAINBOW_HOST=""
# Application credentials issued in the Rainbow developer hub.
RAINBOW_APP_ID=""
RAINBOW_APP_SECRET=""
# Admin account used for server-to-server admin operations (user lookup/creation).
RAINBOW_ADMIN_EMAIL=""
RAINBOW_ADMIN_PASSWORD=""
